+# Hand-maintained chunk registry. One row per chunk ID.
+# file: stream | region | unlabeled (label before any reader is written).
+# status: done | partial | scan-only | unread | set-aside | out-of-scope
+# Edit this file when a tool starts or stops reading a chunk.
+chunk_id	name	file	status	tool	roadmap	note
+0x80034100	ScenerySection (container)	stream	done	scenery/nfs_stream_scenery.py	T1.1-3	one per section; children below
+0x00034101	Scenery header	stream	partial	scenery/nfs_stream_scenery.py	T1.1	only section number (+0x0C) read
+0x00034102	SceneryInfo array (0x48 each)	stream	partial	scenery/nfs_stream_scenery.py	T1.1	name, first solid key, flags read; keys 2-4 unread
+0x00034103	SceneryInstance array (0x60 each)	stream	partial	scenery/nfs_stream_scenery.py	T1.2	flags, position, rotation, guid, info index read
+0x00034105	Scenery tree nodes	stream	unread		T2	completeness tier
+0x00034107	Scenery preculler	stream	unread		T2	keep raw bytes
+0x00034108	Scenery override infos (6 bytes each)	stream	done	scenery/nfs_stream_scenery.py	T1.3	-
+0x00034109	Scenery groups	stream	done	scenery/nfs_stream_scenery.py	T1.3	-
+0x0003410D	Light texture collections	stream	unread		T2	-
+0x80134000	ObjectPack (container)	stream	partial	solids_materials/nfs_solid_reader.py	T1.4	-
+0x80134010	Solid object (container)	stream	done	solids_materials/nfs_solid_reader.py	T1.4	-
+0x00134011	Solid header	stream	partial	solids_materials/nfs_solid_reader.py	T1.4	version, hash, bounds, name read
+0x00134012	Solid texture list	stream	partial	solids_materials/nfs_solid_reader.py	T1.4	first u32 of each 8-byte entry read
+0x0013401A	SolidMarkers (position_marker, 0x50 each)	stream	partial	flares/flare_scenery_scan.py	T1.5	44 chunks at size 92 unexplained
+0x0013401D	Solid morph targets	stream	done	solids_materials/nfs_solid_reader.py	T1.4	-
+0x80134100	Solid Plat (container)	stream	done	solids_materials/nfs_solid_reader.py	T1.4	-
+0x00134B01	Plat vertex buffer	stream	done	solids_materials/nfs_solid_reader.py	T1.4	-
+0x00134B02	Plat mesh entries (shading groups, 144 bytes)	stream	partial	solids_materials/nfs_solid_reader.py	T1.4	see tool_gaps.md
+0x00134B03	Plat indices	stream	done	solids_materials/nfs_solid_reader.py	T1.4	-
+0x00134C02	Plat mesh entry name	stream	done	solids_materials/nfs_solid_reader.py	T1.4	-
+0x00135002	Light AABB	stream	unread		T2	-
+0x00135200	Flare pack (flare::pack + flare::instance)	stream	scan-only	flares/flare_scan.py	T1.5	ID found by discovery mode
+0x33310004	TextureStruct array (0x58 each)	stream	partial	texture_anim/uv_scroll_dump.py	T1.7	UV scroll fields only
+0x33312001	TextureAnimPack header	stream	scan-only	texture_anim/texture_anim_scan.py	T1.7	layout confirmed on two samples
+0x33312002	TextureAnimPack frames (12 bytes each)	stream	scan-only	texture_anim/texture_anim_scan.py	T1.7	first u32 of each entry read
+0xB3312000	TextureAnimPack pack (container)	stream	scan-only	texture_anim/texture_anim_scan.py	T1.7	hex dump only
+0xB3312004	TextureAnimPack inst (container)	stream	scan-only	texture_anim/texture_anim_scan.py	T1.7	hex dump only
